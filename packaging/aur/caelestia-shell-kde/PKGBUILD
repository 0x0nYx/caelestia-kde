# Maintainer: ladybug-me <rajveer2027singh@gmail.com>
#
# The Caelestia shell ported to KDE Plasma: the Quickshell configuration, the
# Caelestia QML plugin, the M3Shapes module, the `caelestia` command with the
# helpers it drives, the data the color pipeline generates from, the Plasma lock
# screen package, and the workspace-tracker KWin effect.
#
# This package owns /usr/bin/caelestia. It used to leave that name to
# caelestia-cli (upstream) and take its palette from it; the pipeline is part of
# this project now, so the command, the helpers, the matugen templates and the
# scheme catalogue all ship here, and nothing depends on caelestia-cli.
#
# The source is a git clone of the tag rather than the release tarball, because the
# tree has two submodules - the dotfiles `caelestia install` deploys and the
# monochrome icon set the shell reads - and a tarball cannot carry a submodule's
# commit. Cloning the tag brings the pins the tag records, and leaves no tarball
# hash to fill in at release time.
#
# To build before a tag exists, point _ref at a branch instead. The fragment carries
# its own keyword, because makepkg resolves `tag=` and `branch=` differently and a
# branch name under `tag=` fails with "invalid reference":
#   _ref=branch=dev makepkg -si
# The version the shell reports is still pkgver, so that is for testing only.

pkgname=caelestia-shell-kde
pkgver=2.4.3
pkgrel=1
pkgdesc='The Caelestia desktop shell, ported to KDE Plasma'
arch=('x86_64' 'aarch64')
url='https://github.com/ladybug-me/caelestia-kde'
license=('GPL-3.0-or-later')
depends=(
    'bash'
    'quickshell'
    'matugen'
    'python'
    # The update checker in the shell and `caelestia-check-updates` both drive git.
    'git'
    'plasma-workspace'
    'qt6-base'
    'qt6-declarative'
    # The shell imports QtMultimedia for audio and the media popouts, and
    # OptionsToolbar.qml still imports Qt5Compat.GraphicalEffects. Both are direct
    # imports, so both are direct dependencies rather than someone's transitive
    # package that happens to be installed.
    'qt6-multimedia'
    'qt6-5compat'
    'qt6-imageformats'
    'qt6-svg'
    'qt6-wayland'
    # KDE Frameworks 6, under the names Arch uses. `kf6-` as a prefix is Fedora's
    # naming; `pacman -S kf6-kconfig` is "target not found".
    'kwindowsystem'
    'kguiaddons'
    'networkmanager-qt'
    'pulseaudio-qt'
    'kglobalaccel'
    'kconfig'
    'kcoreaddons'
    'libqalculate'
    'libpipewire'
    'aubio'
    # Arch's `cava` ships the executable only - no headers, no shared library, no .pc -
    # and the plugin's audio visualiser provider is compiled only when it can find
    # libcava. Without this the build succeeds and the shell comes up with a dead
    # visualiser and nothing to explain it, which is how this package first shipped.
    # libcava is the AUR package that provides the library and headers.
    'libcava'
    'cava'
    'libx11'
    'wayland'
    'ddcutil'
    'brightnessctl'
    'networkmanager'
    'power-profiles-daemon'
    'ttf-material-symbols-variable'
)
# vulkan-headers is here because KWin's CMake package does find_dependency(Vulkan)
# and fails the configure with "Could NOT find Vulkan (missing: Vulkan_INCLUDE_DIR)"
# when only `kwin` is present. Arch's `kwin` does not pull the headers in.
makedepends=('cmake' 'ninja' 'qt6-shadertools' 'extra-cmake-modules' 'kwin' 'vulkan-headers')
optdepends=(
    'ttf-rubik-vf: clock and workspace font'
    'ttf-cascadia-code-nerd: monospace font'
    'konsole: the terminal scheme is written into it and its profiles follow it'
    'spectacle: screenshots'
    'swappy: screenshot editing'
    'gpu-screen-recorder: screen recording'
    'howdy: face unlock'
    'fprintd: fingerprint unlock'
    'asdbctl: Apple Studio Display brightness'
)
provides=('caelestia-shell')
conflicts=('caelestia-shell' 'caelestia-shell-git')

# The tag this package builds from, and what _ref is for. Declared here, below
# pkgver, because the default reads it.
_ref="${_ref:-tag=v$pkgver}"

# Deliberately no `set -e` here. makepkg sources this file into its own shell, so shell
# options set here change makepkg itself: `set -u` makes its own lint helpers die with
# "unbound variable" before the build starts. The paths below are named rather than
# globbed and checked at the end of package() instead, which is where a silent hole
# would otherwise come from.

source=("$pkgname::git+$url#$_ref"
        'caelestia-autostart'
        'caelestia-shell.service')
sha256sums=('SKIP'
            'a918c6b60afab7a0489ac77731c8eac388a22c7047b52dd50c76f53dfa41f62e'
            '8d40d6ec05f5c8fab576710c123d09899a9c6a572be0ec3b882c2cfa4ae2e64d')

prepare() {
    # The submodules, at the commits the tag pins: without them `caelestia install`
    # has no dotfiles to deploy and the shell has no icon set to draw with. A
    # submodule that did not arrive is an empty directory, which copies cleanly and
    # then fails at install time, so it has to be caught here.
    cd "$srcdir/$pkgname"
    git submodule update --init --recursive

    local sub
    for sub in src/dots src/yet-another-monochrome-icon-set; do
        if [[ -z "$(ls -A "$sub" 2>/dev/null)" ]]; then
            echo "submodule $sub is empty after 'git submodule update'" >&2
            return 1
        fi
    done
}

build() {
    cd "$srcdir/$pkgname"
    cmake -B build -S shell -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/ \
        -DVERSION="$pkgver" \
        -DREQUIRE_CAVA=ON \
        -DDISTRIBUTOR="AUR (package: $pkgname)"
    cmake --build build || exit 1

    # The workspace-tracker effect is its own CMake project and links KWin, so
    # it is built against this machine's Plasma instead of shipped prebuilt.
    cmake -B effect-build -S shell/kwin-effects/workspace-tracker -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build effect-build || exit 1
}

package() {
    cd "$srcdir/$pkgname"
    DESTDIR="$pkgdir" cmake --install build
    DESTDIR="$pkgdir" cmake --install effect-build

    # What `caelestia install` runs for the user's half, and the assets it deploys
    # from. It is the same set of step scripts a checkout's installer runs, which is
    # what keeps one implementation of that half instead of two that drift. The
    # scripts read their assets relative to this directory, so the layout here
    # mirrors the checkout's: scripts/, src/dots, shell/assets, assets/.
    install -d "$pkgdir/usr/share/caelestia"
    install -d "$pkgdir/usr/share/caelestia/scripts"
    install -m755 scripts/[0-9]*.sh "$pkgdir/usr/share/caelestia/scripts/"
    cp -r scripts/lib "$pkgdir/usr/share/caelestia/scripts/"
    install -d "$pkgdir/usr/share/caelestia/src" "$pkgdir/usr/share/caelestia/assets" \
        "$pkgdir/usr/share/caelestia/shell/assets"
    cp -r src/dots src/dots-extra "$pkgdir/usr/share/caelestia/src/"
    cp -r shell/assets/wallpapers "$pkgdir/usr/share/caelestia/shell/assets/"
    cp -r assets/org.quickshell.desktop "$pkgdir/usr/share/caelestia/assets/"
    # /usr/share/caelestia/version.env is what `caelestia version` reports, and what
# 08-build-shell.sh copies into ~/.config for the session to read. It has to be the
# version this package was built as - the same number CMake is handed - rather than
# whatever the tree happened to say, or the command and pacman disagree while a release
# is being prepared. A tag's version.env is bumped as part of releasing, and pkgver is
# set ahead of the tag existing.
printf 'VERSION=v%s\n' "$pkgver" > "$pkgdir/usr/share/caelestia/version.env"

    # The login screen. The theme, the helper that keeps the greeter in step with the
    # session, and the drop-in that selects the theme are all /usr and /etc, so a
    # packaged step cannot write them and they ship here. The full variant is the one
    # packaged; mini is a source-install choice. The font goes where the theme reads
    # it from, and the drop-in sorts last so nothing shipped by a distribution or by
    # sddm-kcm can pick a different theme after it.
    install -d "$pkgdir/usr/share/sddm/themes/caelestia/scripts"
    cp -r src/sddm/themes/full/* "$pkgdir/usr/share/sddm/themes/caelestia/"
    install -m755 src/sddm/sync.sh "$pkgdir/usr/share/sddm/themes/caelestia/scripts/sync.sh"
    install -Dm644 src/kde/shells/caelestia.desktop/contents/fonts/GoogleSansFlex.ttf \
        "$pkgdir/usr/share/sddm/themes/caelestia/assets/google-sans-flex/GoogleSansFlex.ttf"
    install -d "$pkgdir/etc/sddm.conf.d"
    cat > "$pkgdir/etc/sddm.conf.d/zz-caelestia.conf" <<'DROPIN'
[General]
GreeterEnvironment=QML_XHR_ALLOW_FILE_READ=1

[Theme]
Current=caelestia
DROPIN

    # The rule that lets the 'input' group use /dev/uinput, which the on-screen
    # keyboard injects through. It is /etc, so it ships here; adding the user to that
    # group is not, and `caelestia install` says so rather than doing it.
    install -d "$pkgdir/usr/lib/udev/rules.d"
    echo 'KERNEL=="uinput", GROUP="input", MODE="0660"' > "$pkgdir/usr/lib/udev/rules.d/80-uinput.rules"

    # The shell reads the monochrome icon set from its own assets, and it is a
    # submodule, so the shell's CMake install does not carry it.
    install -d "$pkgdir/etc/xdg/quickshell/caelestia/assets/icons"
    cp -r src/yet-another-monochrome-icon-set \
        "$pkgdir/etc/xdg/quickshell/caelestia/assets/icons/"

    # The command and the helpers it drives. They are one surface: the dispatcher
    # runs its siblings from its own directory, so they live beside it in /usr/bin
    # and none of them is documented on its own.
    install -d "$pkgdir/usr/bin"
    install -m755 src/bin/* "$pkgdir/usr/bin/"

    # What a palette is generated from: the matugen templates and the named scheme
    # catalogue. caelestia-color looks in $CAELESTIA_DATA_DIR, $CAELESTIA_LIB_DIR,
    # ~/.local/lib/caelestia and /usr/share/caelestia, in that order, so this is
    # found without an environment variable.
    install -d "$pkgdir/usr/share/caelestia"
    cp -r src/matugen src/schemes "$pkgdir/usr/share/caelestia/"

    # The lock screen is a Plasma shell package, not a Quickshell QML module, so
    # the shell's CMake knows nothing about it.
    install -d "$pkgdir/usr/share/plasma/shells"
    cp -r src/kde/shells/caelestia.desktop "$pkgdir/usr/share/plasma/shells/"

    # Starting the shell on login is one systemd user unit, which `caelestia install`
    # enables once (`systemctl --user enable caelestia-shell.service`). There is no
    # /etc/xdg/autostart entry any more: that would give the same shell two ways to
    # start, and the generator's app-caelestiashell@autostart.service races the unit
    # with no ordering between them. The unit name is load bearing in the other
    # direction instead - restart_shell.sh and uninstall.sh both name it.
    install -Dm755 "$srcdir/caelestia-autostart" "$pkgdir/usr/bin/caelestia-autostart"
    install -Dm644 "$srcdir/caelestia-shell.service" \
        "$pkgdir/usr/lib/systemd/user/caelestia-shell.service"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Nothing above reports its own failure - makepkg does not run these steps with
    # errexit - so the result is checked. Each path here is one a packaged install, the
    # shell or the login screen reads, and a copy into a directory that was never
    # created would otherwise ship a package with a hole in it.
    local required=(
        usr/bin/caelestia
        usr/share/caelestia/scripts/03-deploy-configs.sh
        usr/share/caelestia/scripts/lib/install-kind.sh
        usr/share/caelestia/version.env
        usr/share/caelestia/src/dots
        usr/share/caelestia/src/dots-extra
        usr/share/caelestia/shell/assets/wallpapers
        usr/share/caelestia/assets/org.quickshell.desktop
        usr/share/sddm/themes/caelestia/theme.conf
        usr/share/sddm/themes/caelestia/scripts/sync.sh
        etc/sddm.conf.d/zz-caelestia.conf
        usr/lib/systemd/user/caelestia-shell.service
        etc/xdg/quickshell/caelestia/assets/icons/yet-another-monochrome-icon-set
    )
    local path
    for path in "${required[@]}"; do
        if [[ ! -e "$pkgdir/$path" ]]; then
            echo "missing from the package: $path" >&2
            exit 1
        fi
    done
    echo "package layout checked: ${#required[@]} paths"
}
