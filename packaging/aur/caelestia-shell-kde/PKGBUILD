# Maintainer: ladybug-me <rajveer2027singh@gmail.com>
#
# The Caelestia shell ported to KDE Plasma: the Quickshell configuration, the
# Caelestia QML plugin and the M3Shapes module, installed system-wide the way
# quickshell expects to find them.
#
# This package does not own /usr/bin/caelestia. On a packaged system that name
# belongs to caelestia-cli (upstream), which provides the color pipeline and the
# command the QML calls. caelestia-cli-kde replaces both once the pipeline is
# ours; see packaging/aur/README.md.

pkgname=caelestia-shell-kde
pkgver=2.4.2
pkgrel=1
pkgdesc='The Caelestia desktop shell, ported to KDE Plasma'
arch=('x86_64' 'aarch64')
url='https://github.com/ladybug-me/caelestia-kde'
license=('GPL-3.0-or-later')
depends=(
    'bash'
    'quickshell'
    'caelestia-cli'
    'qt6-base'
    'qt6-declarative'
    'qt6-imageformats'
    'qt6-wayland'
    'kf6-kwindowsystem'
    'kf6-kguiaddons'
    'kf6-networkmanager-qt'
    'kf6-pulseaudio-qt'
    'kf6-kglobalaccel'
    'kf6-kconfig'
    'kf6-kcoreaddons'
    'libqalculate'
    'libpipewire'
    'aubio'
    'cava'
    'libx11'
    'wayland'
    'ddcutil'
    'brightnessctl'
    'networkmanager'
    'power-profiles-daemon'
    'ttf-material-symbols-variable'
)
makedepends=('cmake' 'ninja' 'qt6-shadertools')
optdepends=(
    'ttf-rubik-vf: clock and workspace font'
    'ttf-cascadia-code-nerd: monospace font'
    'spectacle: screenshots'
    'swappy: screenshot editing'
    'gpu-screen-recorder: screen recording'
    'howdy: face unlock'
    'fprintd: fingerprint unlock'
    'asdbctl: Apple Studio Display brightness'
)
provides=('caelestia-shell')
conflicts=('caelestia-shell' 'caelestia-shell-git')
source=("$pkgname-v$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        'caelestia-autostart'
        'caelestiashell.desktop'
        'caelestia-shell.service')
sha256sums=('23711329dcfad4e061c7a32304169a147cbd528bbc5427415de0f912c665b2fd'
            'd39eff39e9ebed80859289f1f6b99b2e2c144cbad4c55805d2ec5455723df86b'
            'ff8611340f3fc688ca1655e6cc93671dd1c37f397142a4584f8e013ca6c29a63'
            'a906fbc4fc3e315ff4ec89f74a7bacfbcf9802f44f3707818b3ba8cf2639efac')

build() {
    cd "$srcdir/caelestia-kde-$pkgver"
    cmake -B build -S shell -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/ \
        -DVERSION="$pkgver" \
        -DDISTRIBUTOR="AUR (package: $pkgname)"
    cmake --build build
}

package() {
    cd "$srcdir/caelestia-kde-$pkgver"
    DESTDIR="$pkgdir" cmake --install build

    # The helper commands the shell calls by name. They do not collide with
    # anything caelestia-cli installs, which is only /usr/bin/caelestia.
    install -Dm755 src/bin/caelestia-record "$pkgdir/usr/bin/caelestia-record"
    install -Dm755 src/bin/caelestia-screenshot "$pkgdir/usr/bin/caelestia-screenshot"
    install -Dm755 src/bin/caelestia-shell-ipc "$pkgdir/usr/bin/caelestia-shell-ipc"
    install -Dm755 src/bin/caelestia-check-updates "$pkgdir/usr/bin/caelestia-check-updates"

    # Starting the shell on login. The desktop entry name is load bearing:
    # systemd turns /etc/xdg/autostart/caelestiashell.desktop into
    # app-caelestiashell@autostart.service, which is the unit restart_shell.sh
    # restarts and the lock screen expects.
    install -Dm755 "$srcdir/caelestia-autostart" "$pkgdir/usr/bin/caelestia-autostart"
    install -Dm644 "$srcdir/caelestiashell.desktop" \
        "$pkgdir/etc/xdg/autostart/caelestiashell.desktop"
    install -Dm644 "$srcdir/caelestia-shell.service" \
        "$pkgdir/usr/lib/systemd/user/caelestia-shell.service"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
