#!/usr/bin/env bash
# caelestia - the Caelestia command.
#
# One entry point for the session: start the shell, install, update, take a
# screenshot or a recording, and manage the wallpaper and the scheme.
#
# The subcommands and their flags mirror the upstream Caelestia CLI, so the same
# words work on this port. `wallpaper` and `scheme` are the color pipeline,
# which this port owns: they are implemented in `caelestia-color` rather than
# handed to an installed upstream CLI.
#
# Environment:
#   CAELESTIA_BIN_DIR  where the helper commands live (default: beside this file)
#   CAELESTIA_DIR      the checkout `install` runs from (default: ~/caelestia-kde)

set -euo pipefail

# The shell and the upstream CLI both need these, so they are set up front.
export QML2_IMPORT_PATH="$HOME/.local/lib/qt6/qml:$HOME/.config/quickshell/caelestia${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
export CAELESTIA_LIB_DIR="${CAELESTIA_LIB_DIR:-$HOME/.local/lib/caelestia}"

SELF="$(realpath -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
BIN_DIR="${CAELESTIA_BIN_DIR:-$(dirname -- "$SELF")}"

# helper <name> [args...]
#
# Hand off to the command that implements a subcommand. Those live beside this
# file, so a checkout and an installed copy both find them.
helper() {
    local name="$1"
    shift
    local path="$BIN_DIR/$name"
    if [[ ! -x "$path" ]]; then
        printf '[ERR] %s is missing or not executable: %s\n' "$name" "$path" >&2
        exit 127
    fi
    exec "$path" "$@"
}

usage() {
    cat <<'EOF'
caelestia - control the Caelestia shell

Usage: caelestia <command> [args...]

Commands
  shell [OPTS] [MESSAGE...]    start the shell, or message the running one
  install                      set up this user's half of the shell
  update [REF]                 update the shell and re-apply the configuration
  wallpaper [OPTS]             set the wallpaper and derive the palette from it
  scheme <list|get|set> [...]  manage the color scheme
  screenshot [OPTS]            take a screenshot
  record [OPTS]                record the screen
  version                      print the version
  help                         print this message

Shell options
  -d, --daemon    start the shell detached
  -r, --restart   restart the shell
  -s, --show      list the shell IPC commands
  -l, --log       print the shell log
  -k, --kill      stop the shell

Screenshot options
  -r, --region    capture a region instead of the whole screen

Run 'caelestia <command> -h' for the options of a command.
EOF
}

shell_usage() {
    cat <<'EOF'
Usage: caelestia shell [OPTS] [MESSAGE...]

With no MESSAGE the shell is started. With a MESSAGE, that IPC command is sent
to the running shell, for example: caelestia shell nexus openPage 0 8

Options
  -d, --daemon    start the shell detached. The shell always runs under systemd
                  on KDE, so this is accepted for parity and changes nothing
  -r, --restart   restart the shell
  -s, --show      list the shell IPC commands
  -l, --log       print the shell log
  -k, --kill      stop the shell
EOF
}

cmd_shell() {
    local restart=0 show=0 log=0 stop=0
    local -a message=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--daemon)
                shift
                ;;
            -r|--restart)
                restart=1
                shift
                ;;
            -s|--show)
                show=1
                shift
                ;;
            -l|--log)
                log=1
                shift
                ;;
            -k|--kill)
                stop=1
                shift
                ;;
            -h|--help)
                shell_usage
                return 0
                ;;
            --)
                shift
                message+=("$@")
                break
                ;;
            -*)
                printf '[ERR] unknown option for shell: %s\n' "$1" >&2
                return 2
                ;;
            *)
                message+=("$1")
                shift
                ;;
        esac
    done

    if ((stop)); then
        helper caelestia-shell-ipc quit
    fi
    if ((restart)); then
        helper caelestia-shell-ipc restart
    fi
    if ((show)); then
        helper caelestia-shell-ipc show
    fi
    if ((log)); then
        helper caelestia-shell-ipc log
    fi
    if ((${#message[@]} > 0)); then
        helper caelestia-shell-ipc call "${message[@]}"
    fi

    helper caelestia-shell-ipc start
}

screenshot_usage() {
    cat <<'EOF'
Usage: caelestia screenshot [OPTS]

Options
  -r, --region    capture a region instead of the whole screen

Also accepted by the helper: --save PATH, --open.
EOF
}

cmd_screenshot() {
    local -a args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--region)
                args+=(region)
                shift
                ;;
            -f|--freeze)
                printf '[WARN] screenshot: --freeze has no equivalent here; ignoring\n' >&2
                shift
                ;;
            -h|--help)
                screenshot_usage
                return 0
                ;;
            -*)
                printf '[ERR] unknown option for screenshot: %s\n' "$1" >&2
                return 2
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done

    if ((${#args[@]} == 0)); then
        args+=(full)
    fi
    helper caelestia-screenshot "${args[@]}"
}

# Where the step scripts and the assets they deploy live. A package keeps them in
# /usr/share/caelestia; a checkout has them one directory above this file's. The
# order matches how `caelestia-color` resolves its data, so CAELESTIA_DATA_DIR
# moves both.
packaged_data_dir() {
    local candidate
    for candidate in \
        "${CAELESTIA_DATA_DIR:-}" \
        "$CAELESTIA_LIB_DIR" \
        /usr/share/caelestia \
        "$(dirname -- "$BIN_DIR")"; do
        [[ -n "$candidate" && -f "$candidate/scripts/03-deploy-configs.sh" ]] || continue
        printf '%s\n' "$candidate"
        return 0
    done
    return 1
}

# The user's half, from a package.
#
# A package owns every file under /usr and /etc, so there is no machine to set up
# and nothing to build: what is left is the configuration only the user's own
# files can carry. These are the same scripts the checkout's installer runs, told
# which install they are part of so the sections that write package-owned files
# stay out of it - that split is parity-6, and this is its packaged front end.
#
# The list is that half in the installer's own order: deploy the config files,
# fetch the wallpapers, apply the KDE settings, select the login screen, set up the
# user services, write the environment, tweak the session and create the autostart
# state. The steps before these install packages, which the package manager already
# did; the ones after them install optional apps, which are the package's business.
#
# 05-sddm-theme.sh is in the list because choosing a login screen is the user's
# half: the package ships the theme, the drop-in and the sync helper, and what is
# left is the posthook in cli.json and the greeter's own files.
packaged_install() {
    local data step
    if ! data="$(packaged_data_dir)"; then
        cat >&2 <<'EOF'
[ERR] no installer scripts found.

  A package keeps them in /usr/share/caelestia and runs this command from its own
  copy. Reinstall the package, or set CAELESTIA_DATA_DIR to where they are.
EOF
        return 1
    fi

    # A directory under /usr is a package's. Anything else has to say so -
    # CAELESTIA_INSTALL_KIND=package, which is what a test and an unusual layout
    # use, and what stops a checkout being half-installed from here. A checkout has
    # its own installer, which does the machine's half too.
    if [[ "${CAELESTIA_INSTALL_KIND:-}" != "package" ]]; then
        case "$data" in
            /usr/*) ;;
            *)
                printf '[ERR] %s is a checkout, not a package install.\n\n  Run its installer instead: bash %s/install.sh\n' "$data" "$data" >&2
                return 1
                ;;
        esac
    fi

    local -a steps=(
        03-deploy-configs.sh
        03a-wallpapers.sh
        04-deploy-kde.sh
        05-sddm-theme.sh
        06-services.sh
        08-build-shell.sh
        09-system-tweaks.sh
        10-autostart.sh
    )

    echo "Deploying the user's half of a packaged Caelestia install"
    echo "  steps: $data/scripts"
    echo

    for step in "${steps[@]}"; do
        printf '== %s\n' "$step"
        if ! BUNDLE_DIR="$data" CAELESTIA_INSTALL_KIND=package bash "$data/scripts/$step"; then
            printf '[ERR] %s failed; nothing after it was run.\n' "$step" >&2
            return 1
        fi
        echo
    done

    echo "PROGRESS: done: User configuration applied"
    echo "Log out and back in to start the shell with the new configuration."
}

cmd_install() {
    case "${1:-}" in
        -h|--help)
            cat <<'EOF'
Usage: caelestia install

Set up this user's half of the shell, idempotently: the configuration files, the
KDE settings, the user services, the environment and the autostart state. Run it
after installing the package, and again after each update.

A checkout is installed through its own installer, which does the machine's half
as well: set CAELESTIA_DIR to point at one other than ~/caelestia-kde.
EOF
            return 0
            ;;
    esac
    if [[ $# -gt 0 ]]; then
        printf '[ERR] unknown option for install: %s\n' "$1" >&2
        return 2
    fi

    local root="${CAELESTIA_DIR:-$HOME/caelestia-kde}"
    if [[ -f "$root/install.sh" ]]; then
        exec sh "$root/install.sh"
    fi

    # No checkout, so a package put this command here and owns the files it
    # installed. The user's half is what is left.
    packaged_install
}

cmd_version() {
    local file="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/caelestia/version.env"
    if [[ ! -f "$file" ]]; then
        local candidate
        for candidate in "$BIN_DIR/../../.github/version.env" "$BIN_DIR/../../../.github/version.env"; do
            if [[ -f "$candidate" ]]; then
                file="$candidate"
                break
            fi
        done
    fi

    local version="unknown"
    if [[ -f "$file" ]]; then
        version="$(awk -F= '$1 == "VERSION" { print $2; exit }' "$file")"
        [[ -n "$version" ]] || version="unknown"
    fi
    printf 'caelestia %s\n' "$version"
}

main() {
    local command="${1:-}"
    if [[ -z "$command" ]]; then
        usage
        return 0
    fi
    shift

    case "$command" in
        shell)
            cmd_shell "$@"
            ;;
        install)
            cmd_install "$@"
            ;;
        update)
            helper caelestia-update "$@"
            ;;
        wallpaper|scheme)
            helper caelestia-color "$command" "$@"
            ;;
        screenshot)
            cmd_screenshot "$@"
            ;;
        record)
            helper caelestia-record "$@"
            ;;
        version|--version|-v)
            cmd_version
            ;;
        help|--help|-h)
            usage
            ;;
        *)
            printf '[ERR] unknown command: %s\n\n' "$command" >&2
            usage >&2
            return 2
            ;;
    esac
}

main "$@"
